{
    "name": "cosmira/conform-laravel-tests",
    "type": "project",
    "require": {
        "cosmira/conform": "*@dev",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^13.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../.."
        }
    ],
    "scripts": {
        "test": "@php vendor/bin/phpunit --bootstrap vendor/autoload.php --no-coverage --fail-on-warning StrictModeTest.php"
    }
}
