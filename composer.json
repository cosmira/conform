{
    "name": "cosmira/conform",
    "description": "OpenAPI 3.0 request and response validator for PHP and Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "openapi",
        "yaml",
        "validation",
        "laravel",
        "api"
    ],
    "authors": [
        {
            "name": "Cosmira"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "symfony/yaml": "^6.0 || ^7.0 || ^8.0",
        "symfony/finder": "^6.0 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.0 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "infection/infection": "^0.29 || ^0.35",
        "phpstan/phpstan": "^2.3.5",
        "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "Cosmira\\Conform\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cosmira\\Conform\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "test:coverage": "@php vendor/bin/phpunit --coverage-text",
        "test:types": "@php vendor/bin/phpstan analyse --memory-limit=512M --no-progress",
        "test:rector": [
            "@php vendor/bin/rector validate-config",
            "@php vendor/bin/rector process --dry-run --no-progress-bar"
        ],
        "mutate": "@php vendor/bin/infection --threads=max --min-msi=95 --min-covered-msi=95 --show-mutations",
        "benchmark": "@php -d pcov.enabled=0 -d xdebug.mode=off tools/benchmark.php"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cosmira\\Conform\\Laravel\\OpenApiServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
